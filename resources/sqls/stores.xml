<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
        
<mapper namespace="com.mbc.project.dao.StoresDao">


    <!-- 전체 상가 조회 -->
    <select id="allstores" resultType="com.mbc.project.dto.StoresDto">
        select *
        from stores
        order by floor, storename
    </select>

    <!-- 층별 상가 조회 -->
    <select id="storesfloor"
            parameterType="int"
            resultType="com.mbc.project.dto.StoresDto">
        select *
        from stores
        where floor = #{floor}
        order by storename
    </select>

</mapper>