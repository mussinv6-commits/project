<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
        
<mapper namespace="com.mbc.project.dao.BoardDao">

    <!-- ========================================== -->
    <!-- 1. 자유게시판 (board) -->
    <!-- ========================================== -->

    <!-- 게시글 전체 목록 조회 -->
    <select id="allboard" resultType="com.mbc.project.dto.BoardDto">
        select * from board order by seq desc
    </select>

 	<!-- 게시글 등록 -->
	<insert id="addboard" parameterType="com.mbc.project.dto.BoardDto">
		insert into board(writerid, title, content)	
		values(#{writerid}, #{title}, #{content})
	</insert>
	
	<!-- 게시글 상세 조회 -->
	<select id="detailboard" parameterType="Long" resultType="com.mbc.project.dto.BoardDto">
		select seq, writerid, title, content, readcount, wdate
		from board
		where seq=#{seq}
	</select>
	
	<!-- 조회수 증가 -->
	<update id="updatereadcount" parameterType="Long">
		update board
		set readcount = readcount + 1
		where seq=#{seq}
	</update>







</mapper>
