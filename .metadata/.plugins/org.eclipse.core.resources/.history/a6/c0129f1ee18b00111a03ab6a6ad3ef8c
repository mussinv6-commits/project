    @PostMapping("/findBySellerLogin")
    public MemberDto findBySellerLogin(@RequestBody MemberDto dto) {
    	// 요청받은 상인아이디(seller_id)를 그대로 세팅한 더미데이터 반환
        return new MemberDto(10, "user_test", dto.getSeller_id(), "1234", "테스트상인", "seller@test.com", "없음", 2);
