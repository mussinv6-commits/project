package com.mbc.project.controller;

import java.util.ArrayList;
import java.util.List;

import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RestController;

import com.mbc.project.dto.MemberDto;
import com.mbc.project.service.MemberService;

@RestController
public class MemberController {
	
	final MemberService service;
	
	MemberController(MemberService service) {
		this.service = service;
	}
	
	@PostMapping("/allmember")
	public List<MemberDto> allmember(){
	
		List<MemberDto> dummyList = new ArrayList<>();
		
		// 더미데이터 제작
		dummyList.add(new MemberDto(1, "user01", "seller01", "1234", "홍길동", "hong@test.com", "12가3456", 1));
		dummyList.add(new MemberDto(2, "user02", "seller02", "5678", "이순신", "lee@test.com", "34나5678", 2));
		dummyList.add(new MemberDto(3, "user03", "seller03", "abcd", "강감찬", "kang@test.com", "56다7890", 1));
		
		// 더미 전달용 
		return dummyList;
		
		// 기존 리턴
		// return service.allMemberDao();
	}
	// 2. 일반 아이디로 조회 요청 시 더미데이터 1개 반환
    // 2. 일반 아이디로 조회 요청 시 더미데이터 1개 반환
    @PostMapping("/findByUserId")
    public MemberDto findByUserId(@RequestBody MemberDto dto) {
        // [필수 반영] 완전 소문자 필드 userid 사용
        MemberDto member = new MemberDto();
        member.setSeq(1);
        member.setUserid(dto.getUserid());
        member.setSellerlogin("seller_test");
        member.setPassword("1234");
        member.setName("테스트유저");
        member.setEmail("test@test.com");
        member.setCarnum("99너9999");
        member.setAuth(3); // 일반 회원 권한 (3)
        
        return member;
    }
    
    // 3. 상인 아이디로 조회 요청 시 더미데이터 1개 반환
    @PostMapping("/findBySellerLogin")
    public MemberDto findBySellerLogin(@RequestBody MemberDto dto) {
        // [필수 반영] 완전 소문자 필드 sellerlogin 및 상인 전용 필드(storeno, storename) 반영
        MemberDto seller = new MemberDto();
        seller.setSeq(10);
        seller.setUserid("user_test");
        seller.setSellerlogin(dto.getSellerlogin());
        seller.setPassword("1234");
        seller.setName("테스트상인");
        seller.setEmail("seller@test.com");
        seller.setCarnum("없음");
        seller.setAuth(2); // 상인 회원 권한 (2)
        

        
        return seller;
    }
    // 4. 진짜 데이터를 받아서 DB 테이블에 실제로 저장(가입)하는 기능 추가
    @PostMapping("/join")
    public String joinMember(@RequestBody MemberDto dto) {
        // 프론트나 Postman에서 보낸 dto 데이터를 서비스로 넘겨서 실제 DB에 인서트합니다.
        service.joinMember(dto); 
        return "DB 저장 완료!";
    }
}

	
